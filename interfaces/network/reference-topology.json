{
  "schema_version": 2,
  "profile_id": "exn-bench-wifi-dual-uart-direct-ethernet-v2",
  "status": "reference-integration-profile-not-yet-implemented",
  "normative_icd": "docs/icd/inter-node-links.md",
  "packet_profile": "CCSDS-Space-Packet/PUS-Revision-C/CRC16",
  "packet_budget": {
    "max_decoded_packet_bytes": 8192,
    "ethernet_object_chunk_payload_bytes": 1024
  },
  "physical_links": [
    {
      "id": "ground",
      "endpoints": [
        "gs",
        "pi"
      ],
      "media": "Wi-Fi",
      "protocol": "TCP/IPv4",
      "framing": "raw-concatenated-CCSDS-packets",
      "host_interface": "pi:wlan0"
    },
    {
      "id": "obc_pi_control",
      "endpoints": [
        "obc",
        "pi"
      ],
      "media": "3.3V-UART",
      "peripherals": [
        "STM32:LPUART1",
        "Pi:UART0-GPIO14/15"
      ],
      "baud_initial": 115200,
      "baud_qualification": 921600,
      "uart_mode": "8N1",
      "framing": "COBS-complete-CCSDS-packet-delimiter-00"
    },
    {
      "id": "obc_fpga_control",
      "endpoints": [
        "obc",
        "fpga"
      ],
      "media": "3.3V-UART-via-PL-Pmod",
      "peripherals": [
        "STM32:USART2",
        "KV260:J2-Pmod-PL-UART"
      ],
      "baud_initial": 115200,
      "baud_qualification": 921600,
      "uart_mode": "8N1",
      "framing": "COBS-complete-CCSDS-packet-delimiter-00",
      "requires_pl_firmware": true
    },
    {
      "id": "pi_fpga_data",
      "endpoints": [
        "pi",
        "fpga"
      ],
      "media": "direct-Gigabit-Ethernet",
      "protocol": "TCP/IPv4",
      "framing": "raw-concatenated-CCSDS-packets",
      "requires_switch": false
    }
  ],
  "physical_hosts": [
    {
      "id": "obc",
      "board": "NUCLEO-H755ZI-Q",
      "uart_a": {
        "peripheral": "LPUART1",
        "tx_pin": "PB6",
        "rx_pin": "PB7"
      },
      "uart_b": {
        "peripheral": "USART2",
        "tx_pin": "PD5",
        "rx_pin": "PD6"
      },
      "ethernet_used": false
    },
    {
      "id": "pi",
      "board": "Raspberry Pi 5",
      "wifi_interface": "wlan0",
      "data_interface": "eth0",
      "header_uart": {
        "peripheral": "UART0",
        "tx_gpio": 14,
        "rx_gpio": 15,
        "tx_header_pin": 8,
        "rx_header_pin": 10
      }
    },
    {
      "id": "fpga",
      "board": "AMD Kria KV260",
      "data_interface": "ethernet",
      "control_uart": {
        "connector": "J2 Pmod",
        "requires_pl_logic": true,
        "exact_pl_pins": "TBD after carrier revision constraint review"
      }
    }
  ],
  "networks": {
    "pi_fpga_direct": {
      "network": "10.77.0.0/30",
      "peers": [
        {
          "host": "pi",
          "ip": "10.77.0.1",
          "prefix_length": 30
        },
        {
          "host": "fpga",
          "ip": "10.77.0.2",
          "prefix_length": 30
        }
      ],
      "configuration": "static",
      "default_gateway": null,
      "requires_switch": false,
      "wifi_ethernet_nat": false,
      "wifi_ethernet_bridge": false
    },
    "ground": {
      "medium": "Wi-Fi",
      "topology": "PC-and-Pi-on-secured-access-point-or-PC-hotspot",
      "ip_configuration": "AP-assigned-DHCP",
      "pi_interface": "wlan0"
    }
  },
  "endpoints": [
    {
      "name": "OBC",
      "apid": 256,
      "pus_id": 1,
      "host": "obc",
      "control_link": "obc_pi_control+obc_fpga_control",
      "ethernet_listener": null
    },
    {
      "name": "PI-CAM",
      "apid": 257,
      "pus_id": 2,
      "host": "pi",
      "control_link": "obc_pi_control",
      "ethernet_listener": {
        "ip": "10.77.0.1",
        "tcp_port": 47101
      }
    },
    {
      "name": "FPGA",
      "apid": 258,
      "pus_id": 3,
      "host": "fpga",
      "control_link": "obc_fpga_control",
      "ethernet_listener": {
        "ip": "10.77.0.2",
        "tcp_port": 47102
      }
    },
    {
      "name": "PI-COMMS",
      "apid": 259,
      "pus_id": 4,
      "host": "pi",
      "control_link": "obc_pi_control",
      "ethernet_listener": {
        "ip": "10.77.0.1",
        "tcp_port": 47103
      }
    },
    {
      "name": "PI-MGMT",
      "apid": 260,
      "pus_id": 5,
      "host": "pi",
      "control_link": "obc_pi_control",
      "ethernet_listener": null
    },
    {
      "name": "GS",
      "apid": 240,
      "pus_id": 16,
      "host": "gs",
      "control_link": "ground",
      "ethernet_listener": null
    }
  ],
  "pi_control_router": {
    "name": "exn-linkd",
    "spacecraft_endpoint": false,
    "uart_link": "obc_pi_control",
    "dispatch": "TC destination APID, TM producer APID and intended consumer",
    "independently_supervised_from_pi_comms": true,
    "clients": [
      "PI-CAM",
      "PI-COMMS",
      "PI-MGMT"
    ]
  },
  "ground_listener": {
    "logical_endpoint": "PI-COMMS",
    "binding_interface": "wlan0",
    "bind_address": "<PI_WIFI_IP>",
    "protocol": "TCP",
    "port": 47000,
    "client": "exn_gsd --port tcp://<PI_WIFI_IP>:47000",
    "max_active_command_sessions": 1
  },
  "notes": [
    "Reference topology requires zero Ethernet switches",
    "UART paths carry only bounded CCSDS/PUS-C control/HK, not bulk image objects",
    "Kria control UART requires FPGA PL design and is unavailable if PL is unconfigured",
    "All IP and port allocations are deployment values, not PUS-C endpoint identity",
    "No hard-reset/power-cycle path is wired by this profile",
    "No Wi-Fi gateway/STM32 UART/FPGA PL implementation is claimed operational"
  ]
}
